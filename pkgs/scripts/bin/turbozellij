#!/usr/bin/env bash
# fast zellijing

# If a resurrectable (EXITED) session with this name exists, delete it and its
# cache so we always land on a fresh, correct layout instead of resurrecting a
# possibly-degraded one (e.g. missing tabs from a previous crash/close).
cleanup_if_exited() {
  local name="$1"
  local status_line
  status_line=$(zellij list-sessions --no-formatting 2>/dev/null | grep -E "^${name}[[:space:]]")
  if [ -n "$status_line" ] && echo "$status_line" | grep -q "EXITED"; then
    zellij delete-session --force "${name}" 2>/dev/null
    rm -rf ~/.cache/zellij/*/session_info/"${name}"
  fi
}

case $1 in
  open)
    sessions=$(zellij list-sessions -s 2>/dev/null)
    if [ -z "$sessions" ]; then
      echo "No zellij sessions running"
      exit 0
    fi
    sesh=$(echo "$sessions" | fzf)
    if [ -z "$sesh" ]; then
      exit 0
    fi
    zellij attach "${sesh}"
    ;;

  close)
    sessions=$(zellij list-sessions --no-formatting 2>/dev/null | awk '{print $1}')
    if [ -z "$sessions" ]; then
      echo "No zellij sessions found"
      exit 0
    fi
    if [ -n "$2" ]; then
      zellij delete-session --force "${2}"
      rm -rf ~/.cache/zellij/*/session_info/"${2}"
    else
      sesh=$(echo "$sessions" | fzf)
      if [ -z "$sesh" ]; then
        exit 0
      fi
      zellij delete-session --force "${sesh}"
      rm -rf ~/.cache/zellij/*/session_info/"${sesh}"
    fi
    ;;

  new)
    if [ -z "$2" ]; then
      echo "Please provide a name for the new session"
      exit 1
    fi
    cleanup_if_exited "${2}"
    exec zellij attach --create "${2}" options --default-layout dev
    ;;

  project)
    project=$(find ~/work/ ~/personal/ -mindepth 1 -maxdepth 1 -type d 2>/dev/null | fzf)
    if [ -z "$project" ]; then
      exit 0
    fi

    proj_name=$(basename "${project}" | tr . _)

    cleanup_if_exited "${proj_name}"
    exec zellij attach --create "${proj_name}" options --default-layout dev --default-cwd "${project}"
    ;;

  *)
    echo "Usage: turbozellij [open|close|new|project]"
    exit 1
    ;;
esac

exit 0
